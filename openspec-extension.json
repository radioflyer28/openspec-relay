{
  "apiVersion": "openspec.dev/extensions/v1",
  "id": "relay",
  "version": "0.2.0",
  "requires": {
    "openspec": ">=1.11.0-relay.1 <2.0.0",
    "hostCapabilities": {
      "required": ["structuredResults"],
      "optional": ["agentDispatch", "parallelism", "worktrees", "git", "humanInteraction"]
    }
  },
  "contributes": {
    "workflows": [
      {
        "id": "discuss",
        "name": "OpenSpec Relay Discuss",
        "description": "Reach shared understanding of material product intent before proposal or targeted replanning.",
        "entry": "workflows/discuss.generated.md",
        "artifactRequirements": [],
        "gateDependencies": [],
        "requiredHostCapabilities": ["structuredResults"]
      },
      {
        "id": "plan",
        "name": "OpenSpec Relay Plan",
        "description": "Refine, review, and approve an OpenSpec change for execution.",
        "entry": "workflows/plan.md",
        "artifactRequirements": ["proposal", "specs", "design", "tasks"],
        "gateDependencies": ["relay.assurance"],
        "requiredHostCapabilities": ["structuredResults"]
      },
      {
        "id": "do",
        "name": "OpenSpec Relay Do",
        "description": "Implement, review, repair, and verify an approved OpenSpec change.",
        "entry": "workflows/do.md",
        "artifactRequirements": ["proposal", "specs", "design", "tasks"],
        "gateDependencies": ["relay.assurance"],
        "requiredHostCapabilities": ["structuredResults"],
        "replaces": ["run"]
      },
      {
        "id": "check",
        "name": "OpenSpec Relay Check",
        "description": "Evaluate assurance for an OpenSpec change without expanding its scope.",
        "entry": "workflows/check.md",
        "artifactRequirements": ["proposal", "specs", "design", "tasks"],
        "gateDependencies": ["relay.assurance"],
        "requiredHostCapabilities": ["structuredResults"]
      },
      {
        "id": "status",
        "name": "OpenSpec Relay Status",
        "description": "Report execution, assurance, repair, gate, and human-action state.",
        "entry": "workflows/status.md",
        "artifactRequirements": ["tasks"],
        "gateDependencies": [],
        "requiredHostCapabilities": ["structuredResults"],
        "replaces": ["run-status"]
      },
      {
        "id": "debug",
        "name": "OpenSpec Relay Debug",
        "description": "Start or resume a scientific debugging session for an unresolved finding.",
        "entry": "workflows/debug.md",
        "artifactRequirements": ["proposal", "specs", "design", "tasks"],
        "gateDependencies": ["relay.assurance"],
        "requiredHostCapabilities": ["structuredResults"]
      },
      {
        "id": "uat",
        "name": "OpenSpec Relay UAT",
        "description": "Guide scenario-by-scenario human acceptance for an OpenSpec Relay run.",
        "entry": "workflows/uat.md",
        "artifactRequirements": ["tasks"],
        "gateDependencies": ["relay.assurance"],
        "requiredHostCapabilities": ["structuredResults"]
      }
    ],
    "gates": [
      {
        "id": "relay.assurance",
        "module": "dist/gate.js",
        "export": "relayAssuranceGate",
        "timeoutMs": 30000,
        "requiredHostCapabilities": ["structuredResults"]
      }
    ]
  }
}

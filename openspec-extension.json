{
  "apiVersion": "openspec.dev/extensions/v1",
  "id": "guardrails",
  "version": "0.1.0",
  "requires": {
    "openspec": ">=1.8.0-guardrails.1 <2.0.0",
    "hostCapabilities": {
      "required": ["structuredResults"],
      "optional": ["agentDispatch", "parallelism", "worktrees", "git", "humanInteraction"]
    }
  },
  "contributes": {
    "workflows": [
      {
        "id": "run",
        "name": "Guardrails Run",
        "description": "Execute an OpenSpec change with risk-aware assurance.",
        "entry": "workflows/run.md",
        "artifactRequirements": ["proposal", "specs", "design", "tasks"],
        "gateDependencies": ["guardrails.assurance"],
        "requiredHostCapabilities": ["structuredResults"]
      },
      {
        "id": "check",
        "name": "Guardrails Check",
        "description": "Evaluate assurance for an OpenSpec change without expanding its scope.",
        "entry": "workflows/check.md",
        "artifactRequirements": ["proposal", "specs", "design", "tasks"],
        "gateDependencies": ["guardrails.assurance"],
        "requiredHostCapabilities": ["structuredResults"]
      },
      {
        "id": "run-status",
        "name": "Guardrails Run Status",
        "description": "Report execution, assurance, repair, gate, and human-action state.",
        "entry": "workflows/run-status.md",
        "artifactRequirements": ["tasks"],
        "gateDependencies": [],
        "requiredHostCapabilities": ["structuredResults"]
      }
    ],
    "gates": [
      {
        "id": "guardrails.assurance",
        "module": "dist/gate.js",
        "export": "guardrailsAssuranceGate",
        "timeoutMs": 30000,
        "requiredHostCapabilities": ["structuredResults"]
      }
    ]
  }
}
